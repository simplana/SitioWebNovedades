# ==============================================================================
# FRONTEND ENVIRONMENT VARIABLES (VITE_*)
# ==============================================================================
# These variables are exposed to the frontend code and will be bundled.
# NEVER put secrets or sensitive tokens here - they will be visible to users.

# Supabase Configuration (Frontend)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Loyverse OAuth Configuration (Frontend)
VITE_LOYVERSE_CLIENT_ID=your-client-id-here
VITE_LOYVERSE_CLIENT_SECRET=your-client-secret-here
VITE_LOYVERSE_REDIRECT_URL=https://your-domain.com/auth/loyverse/callback

# ==============================================================================
# BACKEND ENVIRONMENT VARIABLES (Supabase Functions Only)
# ==============================================================================
# These variables are ONLY available in Supabase Edge Functions.
# They are NOT exposed to the frontend and must be configured in Supabase Dashboard.
#
# To configure these:
# 1. Go to Supabase Dashboard > Edge Functions > Settings
# 2. Add these environment variables there
# 3. NEVER add these to frontend .env files

# Paguelo Fácil Configuration (Backend Only - DO NOT USE VITE_ PREFIX)
# PAGUELO_FACIL_ACCESS_TOKEN=your-secret-token-here
# PAGUELO_FACIL_API_URL=https://api.paguelofacil.com