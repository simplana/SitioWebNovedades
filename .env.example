# ==============================================================================
# FRONTEND ENVIRONMENT VARIABLES (VITE_*)
# ==============================================================================
# These variables are exposed to the frontend code and will be bundled.
# NEVER put secrets or sensitive tokens here - they will be visible to users.

# Supabase Configuration (Frontend)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Loyverse OAuth Configuration (Frontend - Public Client ID only)
VITE_LOYVERSE_CLIENT_ID=your-client-id-here
VITE_LOYVERSE_REDIRECT_URL=https://your-domain.com/auth/loyverse/callback

# Google Maps API Key (Frontend - Public API Key)
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# ==============================================================================
# BACKEND ENVIRONMENT VARIABLES (Supabase Functions Only)
# ==============================================================================
# These variables are ONLY available in Supabase Edge Functions.
# They are NOT exposed to the frontend and must be configured in Supabase Dashboard.
#
# To configure these:
# 1. Go to Supabase Dashboard > Edge Functions > Settings
# 2. Add these environment variables there
# 3. NEVER add these to frontend .env files
# 4. NEVER use VITE_ prefix for backend secrets
#
# Estas variables NUNCA deben incluirse en el .env del frontend ni comenzar con VITE_.
# Solo se cargan en las Supabase Edge Functions.

# Paguelo Fácil Configuration (Backend Only - DO NOT USE VITE_ PREFIX)
# CCLW is the merchant web code provided by Paguelo Facil
# Get it from your Paguelo Facil dashboard
# PAGUELO_FACIL_CCLW=your-cclw-merchant-code-here
# PAGUELO_FACIL_ENVIRONMENT=sandbox
# For production, change to: PAGUELO_FACIL_ENVIRONMENT=production
# Sandbox URL: https://sandbox.paguelofacil.com/LinkDeamon.cfm
# Production URL: https://secure.paguelofacil.com/LinkDeamon.cfm

# Loyverse OAuth Configuration (Backend Only - DO NOT USE VITE_ PREFIX)
# Estas variables se usan únicamente en Supabase Edge Functions.
# Nunca deben incluirse en el frontend ni comenzar con VITE_.
# LOYVERSE_CLIENT_ID=your-client-id-here
# LOYVERSE_CLIENT_SECRET=your-client-secret-here

# CORS Configuration (Backend Only)
# ALLOWED_ORIGIN=https://novedadescatolicas.com
# In development, you can use "*" but in production, set your actual domain
